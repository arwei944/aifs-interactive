---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { phases } from '../data/phases';
---

<BaseLayout title="学习路径 — AI 工程从零学起">
  <Header title="学习路径" activeNav="path" />

  <div class="pt-[52px] px-6 lg:px-12 py-10 max-w-[780px] mx-auto">
    <div class="mb-10">
      <h1 class="text-[32px] font-bold text-ink leading-tight tracking-tight mb-3">学习路径</h1>
      <p class="text-[15px] text-ink-2 max-w-[560px]">
        从零开始，循序渐进。每个阶段都建立在前一阶段的知识之上，确保你拥有扎实的 AI 工程基础。
      </p>
    </div>

    <div class="space-y-4">
      {phases.map((phase, idx) => (
        <a href={`/lesson/${phase.id}/${phase.lessons[0]?.id || ''}`} class="block card p-5 hover:shadow-md transition-shadow duration-200 group">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 flex items-center justify-center rounded-full bg-blue/10 text-blue text-[13px] font-bold">
                {phase.num}
              </span>
              <div>
                <h2 class="text-[16px] font-semibold text-ink group-hover:text-blue transition-colors">
                  {phase.shortTitle}
                </h2>
                <p class="text-[13px] text-ink-2">{phase.title}</p>
              </div>
            </div>
            <div class="flex items-center gap-3 text-[13px] text-ink-2">
              <span>{phase.lessons.length} 课时</span>
              <span>{phase.duration}</span>
              <span class:list={[
                'text-[12px] font-medium px-2.5 py-0.5 rounded-chip',
                phase.status === 'completed' ? 'bg-green/10 text-green' : 'bg-black/[0.04] text-ink-3',
              ]}>
                {phase.status === 'completed' ? '已完成' : '未开始'}
              </span>
            </div>
          </div>
          <div class="flex flex-wrap gap-1.5 ml-11">
            {phase.lessons.slice(0, 5).map(l => (
              <span class="text-[11px] text-ink-2 bg-black/[0.03] px-2 py-0.5 rounded">
                {l.num}. {l.title}
              </span>
            ))}
            {phase.lessons.length > 5 && (
              <span class="text-[11px] text-ink-3 bg-black/[0.03] px-2 py-0.5 rounded">
                +{phase.lessons.length - 5} 更多
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
