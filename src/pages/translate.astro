---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { phases } from '../data/phases';
---

<BaseLayout title="翻译监控 — AI 工程从零学起">
  <Header title="翻译监控" activeNav="translate" />

  <div class="pt-[52px] min-h-screen bg-[#f5f5f7]">
    <div class="max-w-5xl mx-auto px-6 py-8">

      <!-- 标题区 -->
      <div class="mb-8">
        <h1 class="text-2xl font-semibold text-ink tracking-tight">翻译进度监控</h1>
        <p class="text-sm text-ink-2 mt-1">实时查看 Markdown 课程内容翻译状态 · 多进程并行</p>
      </div>

      <!-- 统计卡片 -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8" id="stats-cards">
        <div class="bg-white rounded-[12px] p-5 shadow-sm border border-black/[0.04]">
          <div class="text-xs text-ink-2 mb-1">翻译进度</div>
          <div class="text-3xl font-semibold text-ink" id="stat-progress">--</div>
          <div class="text-xs text-ink-2 mt-1" id="stat-progress-label">加载中...</div>
        </div>
        <div class="bg-white rounded-[12px] p-5 shadow-sm border border-black/[0.04]">
          <div class="text-xs text-ink-2 mb-1">已翻译</div>
          <div class="text-3xl font-semibold text-green-600" id="stat-ok">--</div>
          <div class="text-xs text-ink-2 mt-1">/ 435 个文件</div>
        </div>
        <div class="bg-white rounded-[12px] p-5 shadow-sm border border-black/[0.04]">
          <div class="text-xs text-ink-2 mb-1">失败</div>
          <div class="text-3xl font-semibold text-red-500" id="stat-failed">--</div>
          <div class="text-xs text-ink-2 mt-1">需要重试</div>
        </div>
        <div class="bg-white rounded-[12px] p-5 shadow-sm border border-black/[0.04]">
          <div class="text-xs text-ink-2 mb-1">运行时间</div>
          <div class="text-3xl font-semibold text-blue-500" id="stat-elapsed">--</div>
          <div class="text-xs text-ink-2 mt-1" id="stat-speed">--</div>
        </div>
      </div>

      <!-- 总进度条 -->
      <div class="bg-white rounded-[12px] p-6 shadow-sm border border-black/[0.04] mb-8">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm font-medium text-ink">总体进度</span>
          <span class="text-sm text-ink-2" id="progress-percent">0%</span>
        </div>
        <div class="w-full h-3 bg-gray-100 rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-blue-500 to-blue-400 rounded-full transition-all duration-500 ease-out" id="progress-bar" style="width: 0%"></div>
        </div>
        <div class="flex items-center justify-between mt-2">
          <span class="text-xs text-ink-2" id="progress-detail">0 / 435</span>
          <span class="text-xs text-ink-2" id="progress-eta">预计剩余: 计算中...</span>
        </div>
      </div>

      <!-- 并行工作进程 -->
      <div class="bg-white rounded-[12px] p-6 shadow-sm border border-black/[0.04] mb-8">
        <h2 class="text-sm font-semibold text-ink mb-4">并行工作进程</h2>
        <div class="space-y-3" id="worker-cards">
          <div class="text-xs text-ink-2">等待工作进程启动...</div>
        </div>
      </div>

      <!-- 阶段进度 -->
      <div class="bg-white rounded-[12px] p-6 shadow-sm border border-black/[0.04] mb-8">
        <h2 class="text-sm font-semibold text-ink mb-4">各阶段进度</h2>
        <div class="space-y-3" id="phase-bars">
          <!-- 动态填充 -->
        </div>
      </div>

      <!-- 翻译日志 -->
      <div class="bg-white rounded-[12px] p-6 shadow-sm border border-black/[0.04]">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-semibold text-ink">翻译日志</h2>
          <div class="flex items-center gap-2">
            <button id="btn-auto-scroll" class="text-xs px-3 py-1.5 rounded-lg bg-blue-50 text-blue-600 hover:bg-blue-100 transition-colors">
              自动滚动: 开
            </button>
            <button id="btn-refresh" class="text-xs px-3 py-1.5 rounded-lg bg-gray-50 text-ink-2 hover:bg-gray-100 transition-colors">
              刷新
            </button>
          </div>
        </div>
        <div class="text-xs text-ink-2 mb-3" id="log-summary">加载中...</div>
        <div class="max-h-[500px] overflow-y-auto rounded-lg border border-black/[0.04]" id="log-container">
          <div class="divide-y divide-gray-50" id="log-list">
            <!-- 动态填充 -->
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- 传递阶段数据到前端 -->
  <script define:vars={{ phaseData: phases.map(p => ({ id: String(p.num).padStart(2, '0'), name: p.shortTitle, total: p.lessons.length })) }}>
    window.__PHASE_DATA__ = phaseData;
  </script>

  <style>
    /* 新增日志条目高亮动画 */
    @keyframes logFlash {
      0% { background-color: rgba(0, 113, 227, 0.12); }
      100% { background-color: transparent; }
    }
    .log-new {
      animation: logFlash 2s ease-out forwards;
    }
    /* Worker 脉冲指示灯 */
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }
    .worker-pulse {
      animation: pulse 1.5s ease-in-out infinite;
    }
  </style>

  <script>
    const TOTAL = 435;
    const PHASES = (window as any).__PHASE_DATA__ || [];
    const WORKER_IDS = ['worker-A', 'worker-B', 'worker-C'];
    const WORKER_COLORS = ['#0071e3', '#af52de', '#34c759'];
    const WORKER_LABELS = ['Worker A (Phase 5-9)', 'Worker B (Phase 10-14)', 'Worker C (Phase 15-19)'];

    let autoScroll = true;
    let lastLogCount = 0;
    let workerDataMap: Record<string, any> = {};

    function formatDuration(seconds: number): string {
      if (seconds < 60) return `${Math.round(seconds)}s`;
      if (seconds < 3600) return `${Math.floor(seconds / 60)}m ${Math.round(seconds % 60)}s`;
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      return `${h}h ${m}m`;
    }

    function formatTime(ts: number): string {
      const d = new Date(ts * 1000);
      return d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
    }

    // 更新统计卡片
    function updateStats(data: any) {
      const translated = data.translated?.length || 0;
      const failed = data.failed?.length || 0;
      const pct = ((translated / TOTAL) * 100).toFixed(1);
      const startTime = data.start_time || Date.now() / 1000;
      const elapsed = Date.now() / 1000 - startTime;
      const speed = elapsed > 0 ? (translated / elapsed * 60) : 0;
      const remaining = speed > 0 ? ((TOTAL - translated) / speed * 60) : 0;

      document.getElementById('stat-progress')!.textContent = `${pct}%`;
      document.getElementById('stat-progress-label')!.textContent =
        translated >= TOTAL ? '✅ 全部完成' : '翻译进行中...';
      document.getElementById('stat-ok')!.textContent = String(translated);
      document.getElementById('stat-failed')!.textContent = String(failed);
      document.getElementById('stat-elapsed')!.textContent = formatDuration(elapsed);
      document.getElementById('stat-speed')!.textContent = speed > 0 ? `${speed.toFixed(1)} 文件/分钟` : '--';

      document.getElementById('progress-bar')!.setAttribute('style', `width: ${pct}%`);
      document.getElementById('progress-percent')!.textContent = `${pct}%`;
      document.getElementById('progress-detail')!.textContent = `${translated} / ${TOTAL}`;
      document.getElementById('progress-eta')!.textContent =
        remaining > 0 && translated < TOTAL
          ? `预计剩余: ${formatDuration(remaining)}`
          : translated >= TOTAL ? '✅ 已完成' : '计算中...';

      updatePhaseBars(data.translated || []);
      return { translated, failed, pct };
    }

    // 更新阶段进度条
    function updatePhaseBars(translated: string[]) {
      const container = document.getElementById('phase-bars')!;
      const translatedSet = new Set(translated);

      const barsHtml = PHASES.map(phase => {
        const phaseFiles = translated.filter(f => f.startsWith(phase.id + '-'));
        const phaseTotal = phase.total || 15;
        const phasePct = Math.min(100, (phaseFiles.length / phaseTotal) * 100);

        return `
          <div class="flex items-center gap-3">
            <span class="text-xs text-ink-2 w-[140px] flex-shrink-0 truncate" title="${phase.name}">
              ${phase.id}. ${phase.name}
            </span>
            <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full rounded-full transition-all duration-500 ${phasePct >= 100 ? 'bg-green-400' : phasePct > 0 ? 'bg-blue-400' : 'bg-gray-200'}"
                   style="width: ${phasePct}%"></div>
            </div>
            <span class="text-xs text-ink-2 w-[50px] text-right">${phaseFiles.length}/${phaseTotal}</span>
          </div>
        `;
      }).join('');

      container.innerHTML = barsHtml;
    }

    // 更新 Worker 进程卡片
    function updateWorkers() {
      const container = document.getElementById('worker-cards')!;
      let html = '';
      let anyActive = false;

      WORKER_IDS.forEach((wid, i) => {
        const data = workerDataMap[wid];
        const color = WORKER_COLORS[i];
        const label = WORKER_LABELS[i];

        if (!data) return;

        const pct = data.total > 0 ? Math.round((data.completed / data.total) * 100) : 0;
        const isRunning = data.status === 'running';
        const isDone = data.status === 'done';
        const elapsed = data.start_time ? (Date.now() / 1000 - data.start_time) : 0;
        const speed = elapsed > 0 && data.completed > 0 ? (data.completed / elapsed) : 0;
        const eta = speed > 0 && !isDone ? ((data.total - data.completed) / speed) : 0;

        if (isRunning) anyActive = true;

        const statusIcon = isDone ? '✅' : isRunning ? '<span class="worker-pulse">🟢</span>' : '⏸️';
        const statusText = isDone ? '已完成' : isRunning ? '运行中' : '等待中';

        html += `
          <div class="flex items-center gap-4 p-4 rounded-xl border border-black/[0.04] ${isRunning ? 'bg-gray-50/50' : ''}">
            <div class="flex-shrink-0 text-lg">${statusIcon}</div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between mb-1.5">
                <span class="text-sm font-medium text-ink">${label}</span>
                <span class="text-xs text-ink-2">${statusText} · ${pct}%</span>
              </div>
              <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden mb-1.5">
                <div class="h-full rounded-full transition-all duration-700 ease-out"
                     style="width: ${pct}%; background-color: ${color}"></div>
              </div>
              <div class="flex items-center justify-between text-xs text-ink-2">
                <span>${data.completed} / ${data.total} 文件</span>
                <span>${speed > 0 ? `${speed.toFixed(2)} 文件/s` : ''}${eta > 0 ? ` · ETA ${formatDuration(eta)}` : ''}</span>
              </div>
              ${data.current_file ? `<div class="text-xs text-ink-2 mt-1 truncate">📄 ${data.current_file}</div>` : ''}
            </div>
          </div>
        `;
      });

      if (!html) {
        html = '<div class="text-xs text-ink-2">等待工作进程启动...</div>';
      }

      container.innerHTML = html;
    }

    // 更新日志（增量追加，不刷新整个列表）
    function updateLog(logs: any[]) {
      const container = document.getElementById('log-list')!;
      const summary = document.getElementById('log-summary')!;
      const okCount = logs.filter(l => l.status === 'ok').length;
      const errCount = logs.filter(l => l.status === 'error').length;
      summary.textContent = `共 ${logs.length} 条记录，成功 ${okCount}，失败 ${errCount}`;

      const newLogs = logs.slice(lastLogCount);
      if (newLogs.length === 0) return;

      const html = newLogs.reverse().map(log => {
        const isError = log.status === 'error';
        const icon = isError ? '❌' : '✅';
        const time = log.time ? formatTime(log.time) : '--:--:--';
        const msg = isError && log.msg ? ` — ${log.msg.slice(0, 80)}` : '';

        return `
          <div class="log-new flex items-center gap-3 px-4 py-2.5 text-xs hover:bg-gray-50/50 transition-colors ${isError ? 'bg-red-50/30' : ''}">
            <span class="flex-shrink-0">${icon}</span>
            <span class="font-mono text-ink-2 w-[70px] flex-shrink-0">${time}</span>
            <span class="font-mono ${isError ? 'text-red-600' : 'text-ink'}">${log.file}</span>
            ${msg ? `<span class="text-red-400 truncate">${msg}</span>` : ''}
          </div>
        `;
      }).join('');

      container.insertAdjacentHTML('afterbegin', html);
      lastLogCount = logs.length;

      if (autoScroll) {
        container.scrollTop = 0;
      }
    }

    // 获取总进度
    async function fetchProgress() {
      try {
        const res = await fetch('/api/translate-progress.json?t=' + Date.now());
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        updateStats(data);
        return data;
      } catch (e) {
        console.warn('获取进度失败:', e);
        return null;
      }
    }

    // 获取日志
    async function fetchLog() {
      try {
        const res = await fetch('/api/translate-log.json?t=' + Date.now());
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        updateLog(data.log || []);
      } catch (e) {
        console.warn('获取日志失败:', e);
      }
    }

    // 获取各 Worker 状态
    async function fetchWorkers() {
      try {
        const res = await fetch(`/api/workers.json?t=${Date.now()}`);
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const workers: any[] = await res.json();
        let changed = false;
        workers.forEach(w => {
          if (!w || !w.id) return;
          if (JSON.stringify(workerDataMap[w.id]) !== JSON.stringify(w)) {
            workerDataMap[w.id] = w;
            changed = true;
          }
        });
        if (changed) updateWorkers();
      } catch (e) {
        console.warn('获取 worker 状态失败:', e);
      }
    }

    // 自动滚动按钮
    document.getElementById('btn-auto-scroll')!.addEventListener('click', function() {
      autoScroll = !autoScroll;
      this.textContent = `自动滚动: ${autoScroll ? '开' : '关'}`;
      this.classList.toggle('bg-blue-50', autoScroll);
      this.classList.toggle('text-blue-600', autoScroll);
      this.classList.toggle('bg-gray-50', !autoScroll);
      this.classList.toggle('text-ink-2', !autoScroll);
    });

    // 刷新按钮
    document.getElementById('btn-refresh')!.addEventListener('click', () => {
      fetchProgress();
      fetchLog();
      fetchWorkers();
    });

    // 初始化 + 定时轮询
    async function init() {
      await fetchProgress();
      await fetchLog();
      await fetchWorkers();
      // 每 3 秒刷新一次（更快响应）
      setInterval(async () => {
        await Promise.all([fetchProgress(), fetchLog(), fetchWorkers()]);
      }, 3000);
    }

    init();
  </script>
</BaseLayout>
