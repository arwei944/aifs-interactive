---
interface Lesson {
  num: string;
  title: string;
  status: 'done' | 'active' | 'pending';
  href?: string;
}

interface Phase {
  id: string;
  label: string;
  status: 'done' | 'current' | 'pending';
  href?: string;
}

interface Props {
  currentPhase: string;
  lessons: Lesson[];
  phases: Phase[];
}

const { currentPhase, lessons, phases } = Astro.props;
---

<aside class="bg-white/60 backdrop-blur-xl border-r border-border w-[240px] pt-5 overflow-y-auto max-h-[calc(100vh-52px)] sticky top-[52px] hidden lg:block">
  <div class="mb-6">
    <div class="text-micro font-semibold text-ink-3 uppercase tracking-wider px-5 mb-1.5">
      {currentPhase}
    </div>
    <div class="pl-3">
      {lessons.map(lesson => (
        <a
          href={lesson.href || '#'}
          class:list={[
            'flex items-center gap-2 py-1.5 px-4 mx-1 rounded-md text-caption transition-all duration-150',
            lesson.status === 'active'
              ? 'text-blue bg-blue/[0.08] font-medium'
              : lesson.status === 'done'
                ? 'text-ink-2 hover:bg-black/[0.03] hover:text-ink'
                : 'text-ink-2 hover:bg-black/[0.03] hover:text-ink',
          ]}
        >
          <span class:list={[
            'w-3.5 h-3.5 rounded-full border-[1.5px] flex items-center justify-center text-[8px] flex-shrink-0',
            lesson.status === 'done' ? 'bg-green border-green text-white' : 'border-border-2',
          ]}>
            {lesson.status === 'done' ? '✓' : lesson.num}
          </span>
          {lesson.title}
        </a>
      ))}
    </div>
  </div>

  <div>
    <div class="text-micro font-semibold text-ink-3 uppercase tracking-wider px-5 mb-1.5">
      全部阶段
    </div>
    {phases.map(phase => (
      <a
        href={phase.href || `/path`}
        class:list={[
          'flex items-center gap-2.5 py-[7px] px-5 text-[13px] transition-all duration-150',
          phase.status === 'current'
            ? 'text-blue bg-blue/[0.06]'
            : phase.status === 'done'
              ? 'text-ink-2 hover:bg-black/[0.03] hover:text-ink'
              : 'text-ink-2 hover:bg-black/[0.03] hover:text-ink',
        ]}
      >
        <span class:list={[
          'w-[7px] h-[7px] rounded-full flex-shrink-0',
          phase.status === 'done' ? 'bg-green' : phase.status === 'current' ? 'bg-blue' : 'bg-border-2',
        ]}></span>
        {phase.label}
      </a>
    ))}
  </div>
</aside>
